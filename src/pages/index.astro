---
const demoNumber = import.meta.env.PUBLIC_DEMO_NUMBER || '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const demoHref = demoNumber ? `tel:${demoNumber.replace(/[^+\d]/g,'')}` : '#live-demo';
const trialHref = '#trial-signup';
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Missie Calls — Keep working. Missie has your missed calls covered.</title>
  <meta name="description" content="Busy on the job? Missie texts missed callers, finds out what they need and sends you the details. Try the live demo and start a 14-day free trial." />
  <meta name="theme-color" content="#f8f0e3" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Fraunces:opsz,wght,SOFT,WONK@9..144,600,20,1;9..144,700,20,1;9..144,800,20,1&display=swap" rel="stylesheet" />
  <style is:global>
    :root{--cream:#f8f0e3;--paper:#fff9ee;--navy:#142b39;--red:#b82e27;--rust:#da6540;--muted:#56646a;--line:#e4d9c9;--font:'DM Sans',Arial,sans-serif;--display:'Fraunces',Georgia,serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--navy);font-family:var(--font);-webkit-font-smoothing:antialiased}button,a{ -webkit-tap-highlight-color:transparent}a{color:inherit}button{font:inherit}img{max-width:100%}.shell{max-width:1200px;margin:auto;padding:0 32px}p{line-height:1.58}.topbar{position:relative;z-index:10;background:var(--cream);border-bottom:1px solid rgba(20,43,57,.07)}.nav{height:94px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;text-decoration:none;width:206px}.brand img{height:62px;width:200px;object-fit:contain;object-position:left}.brand-title{font:800 italic 28px/1 var(--display);letter-spacing:-.065em;color:var(--red);white-space:nowrap}.brand-title b{color:var(--navy)}.navlinks{display:flex;align-items:center;gap:32px}.navlinks>a:not(.btn){font-size:14px;font-weight:800;text-decoration:none}.navlinks>a:not(.btn):hover{color:var(--red)}.btn{display:inline-flex;gap:12px;align-items:center;justify-content:center;text-decoration:none;font-size:15px;font-weight:800;border:2px solid transparent;border-radius:8px;padding:16px 23px;min-height:55px;transition:transform .18s,background .18s;cursor:pointer;white-space:nowrap}.btn:hover{transform:translateY(-2px)}.btn.primary{background:var(--red);color:white;box-shadow:4px 4px 0 rgba(20,43,57,.17)}.btn.primary:hover{background:#9c211e}.btn.outline{background:transparent;color:var(--navy);border-color:var(--navy)}.btn.light{background:var(--paper);color:var(--red)}.btn.small{padding:12px 20px;min-height:45px;font-size:13px}.btn[aria-disabled='true']{opacity:.6;cursor:not-allowed}.eyebrow{display:inline-block;font-weight:800;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--red)}.hero{overflow:hidden}.hero-grid{min-height:656px;display:grid;grid-template-columns:1.02fr .98fr;align-items:center;position:relative;gap:35px}.hero-copy{padding:58px 0 95px;z-index:2}.hero h1{font:800 clamp(47px,5.7vw,78px)/1.04 var(--display);letter-spacing:-.048em;max-width:710px;margin:24px 0 24px}.hero h1 em{font-style:normal;color:var(--red)}.hero-lede{max-width:535px;font-size:19px;color:#334751;margin:0 0 29px;line-height:1.58}.actions{display:flex;gap:13px;flex-wrap:wrap}.mini-proof{display:flex;align-items:center;gap:12px;margin-top:24px;color:#536169;font-size:13px;font-weight:700}.mini-proof:before{content:'✓';display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#d8e6d9;color:#2c6b44}.hero-art{height:100%;display:flex;justify-content:center;align-items:end;position:relative}.hero-art:before{content:'';position:absolute;width:590px;height:590px;border-radius:50%;background:#eedfcb;left:13%;top:6%;border:1px solid #e5d1ba}.hero-art:after{content:'';position:absolute;width:500px;height:500px;border-radius:50%;border:2px dashed rgba(184,46,39,.2);left:25%;top:10%;transform:rotate(20deg)}.hero-art img{position:relative;z-index:1;height:min(610px,51vw);width:auto;max-width:none;object-fit:contain;object-position:bottom;filter:drop-shadow(0 9px 0 rgba(0,0,0,.035))}.ribbon{background:var(--navy);color:#fff9ee}.ribbon-inner{min-height:97px;display:grid;grid-template-columns:repeat(3,1fr);align-items:center;gap:24px}.ribbon-item{display:flex;align-items:center;gap:17px;font-size:15px;font-weight:800}.ribbon-icon svg,.benefit-glyph svg{display:block;width:24px;height:24px}.ribbon-icon{flex:0 0 42px;height:42px;border:1.5px solid rgba(255,255,255,.45);border-radius:50%;display:grid;place-items:center;font-size:20px;color:#ffe3b2}.section{padding:105px 0}.section-head{max-width:740px;margin:0 auto 52px;text-align:center}.section h2{font:800 clamp(39px,4.6vw,59px)/1.12 var(--display);letter-spacing:-.04em;margin:14px 0}.section-head p{font-size:17px;color:var(--muted);margin:15px auto}.demo{background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.demo-grid{display:grid;grid-template-columns:.91fr 1.09fr;gap:65px;align-items:center}.demo-copy h2{margin:16px 0 20px}.demo-copy>p{font-size:18px;color:#41515a;max-width:460px}.steps{margin:28px 0 32px;display:grid;gap:20px}.step{display:flex;gap:16px;align-items:start}.step-num{width:32px;height:32px;border-radius:50%;background:#f3d8c3;display:grid;place-items:center;color:var(--red);font-weight:900;flex-shrink:0}.step strong{display:block;font-weight:800}.step p{margin:4px 0 0;font-size:14px;color:var(--muted)}.demo-availability{margin-top:15px;color:#7b5b4b;font-size:12px}.phone-wrap{background:#edddc8;padding:46px 37px;border-radius:21px;position:relative;box-shadow:12px 12px 0 #d6c4ae}.phone-wrap:before{content:'A LITTLE PREVIEW';position:absolute;right:23px;top:20px;font-size:11px;letter-spacing:.12em;font-weight:900;color:#9b4b39;transform:rotate(5deg)}.phone{border:9px solid #192c37;box-shadow:0 12px 0 rgba(20,43,57,.22);border-radius:37px;background:#f7f5ef;max-width:370px;margin:auto;overflow:hidden}.phone-top{height:44px;background:#142b39;display:flex;align-items:center;justify-content:center;color:white;font-size:12px;font-weight:800}.phone-top:before{content:'';width:65px;height:9px;background:#304652;border-radius:9px}.phone-head{display:flex;align-items:center;gap:11px;background:white;padding:16px 19px;border-bottom:1px solid #e8e7e2}.avatar{width:39px;height:39px;border-radius:50%;background:#b52e27;color:#fff7ed;display:grid;place-items:center;font:800 italic 26px var(--display)}.phone-head strong{display:block;font-size:13px}.phone-head small{font-size:11px;color:#718087}.messages{height:345px;overflow-y:auto;padding:20px 16px;display:flex;flex-direction:column;gap:11px}.bubble{padding:12px 14px;border-radius:17px;max-width:86%;font-size:13px;line-height:1.45;animation:pop .25s ease both}.bubble.them{align-self:start;background:#e5e7e7;border-bottom-left-radius:4px}.bubble.us{align-self:end;background:#a9cf9b;border-bottom-right-radius:4px}.bubble.summary{background:#fff1d1;border:1px solid #dcb98c;max-width:95%}.phone-bottom{height:48px;border-top:1px solid #e2e1dc;display:flex;align-items:center;padding:8px 15px;gap:8px;background:#fafaf8}.phone-bottom span{border:1px solid #dadfdf;color:#9caaa9;border-radius:20px;padding:5px 12px;font-size:11px;flex:1}.phone-bottom i{font-style:normal;color:#5b9b71}.preview-controls{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:27px auto 0;max-width:380px}.text-button{background:transparent;border:0;color:var(--navy);text-decoration:underline;cursor:pointer;font-size:13px;font-weight:800}.progress-dots{display:flex;gap:6px}.progress-dots i{width:7px;height:7px;border-radius:100%;background:#c8b09b}.progress-dots i.on{background:var(--red)}@keyframes pop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}.promise{background:var(--cream)}.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.benefit{border:1px solid #e2d3bd;background:#fff8ed;border-radius:12px;padding:30px;box-shadow:5px 5px 0 #eee0cc}.benefit .benefit-glyph{height:48px;width:48px;display:grid;place-items:center;border-radius:11px;background:#f6ddd1;color:#b22e25;font-size:23px;font-weight:800}.benefit h3{font:800 26px var(--display);letter-spacing:-.02em;margin:20px 0 8px}.benefit p{font-size:15px;margin:0;color:#56646a}.aside{margin:34px auto 0;text-align:center;font:700 italic 21px var(--display);color:var(--red)}.value{background:#142b39;color:#fff9ec}.value-grid{display:grid;grid-template-columns:1fr .86fr;gap:70px;align-items:center}.value h2{margin:13px 0 21px}.value p{font-size:18px;color:#d5dedb}.value .eyebrow{color:#efb993}.quote-card{border:1px solid #63808c;padding:35px;background:#1d3a49;border-radius:12px;transform:rotate(1deg);box-shadow:10px 10px 0 rgba(255,255,255,.07)}.quote-card small{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#d3b68f;font-weight:800}.quote-card h3{font:800 25px var(--display);margin:15px 0}.quote-card dl{margin:0;display:grid;gap:11px}.quote-card dl div{border-bottom:1px solid #41616f;padding:0 0 10px;display:flex;gap:18px}.quote-card dt{width:120px;color:#b8c8cc;font-size:13px}.quote-card dd{margin:0;font-weight:700;font-size:14px}.note{margin-top:15px;font-size:11px;color:#a5c0c4}.price{background:var(--paper)}.price-grid{display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:100px}.price h2{max-width:650px}.price .lede{font-size:18px;color:#546169}.price ul{list-style:none;padding:0;margin:26px 0;display:grid;gap:12px}.price li{font-weight:700}.price li::before{content:'✓';color:var(--red);margin-right:12px}.price-card{background:var(--cream);border:2px solid var(--navy);border-radius:14px;padding:35px;box-shadow:9px 9px 0 #d8b9a6}.price-card .label{font-weight:900;text-transform:uppercase;letter-spacing:.13em;font-size:12px;color:var(--red)}.price-card .amount{font:800 69px/1.2 var(--display);letter-spacing:-.06em;margin:13px 0 5px}.price-card .amount small{font:600 18px var(--font);letter-spacing:0;color:#536169}.price-card p{font-size:14px;color:#5f6b6c}.price-card .btn{width:100%;margin-top:15px}.trial{padding:80px 0;background:var(--red);color:#fff8eb;position:relative;overflow:hidden}.trial:after{content:'M';font:800 320px/1 var(--display);position:absolute;right:3%;bottom:-140px;color:rgba(255,255,255,.06);transform:rotate(-13deg)}.trial-inner{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:28px}.trial h2{font:800 clamp(39px,4vw,58px)/1.12 var(--display);max-width:690px;letter-spacing:-.03em;margin:0}.trial p{font-size:17px;margin:15px 0 0;color:#ffe0ce}.footer{padding:35px 0;background:#102431;color:#dedfd9}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}.footer span{font-size:12px}.footer .footer-brand{font:800 italic 29px var(--display);color:#fff0dd}.footer p{font-size:12px;margin:0;color:#b1bbba}.footer a{text-decoration:none}.mobile-nav{display:none}.disclosure{font-size:12px;color:#746e68}.anchor-offset{scroll-margin-top:35px} :focus-visible{outline:3px solid #e68b4e;outline-offset:4px}
    @media(max-width:1000px){.hero-grid{min-height:560px}.hero-art img{height:540px}.hero-art:before{width:460px;height:460px}.demo-grid{gap:35px}.price-grid{gap:45px}}
    @media(max-width:750px){.shell{padding:0 22px}.nav{height:74px}.brand{width:151px}.brand img{width:155px;height:53px}.navlinks>a:not(.btn){display:none}.navlinks .btn{padding:10px 12px;font-size:12px;min-height:40px}.hero-grid{display:flex;flex-direction:column;gap:0;min-height:auto}.hero-copy{padding:55px 0 12px;text-align:left}.hero h1{font-size:clamp(46px,11.5vw,69px);max-width:640px;margin:17px 0}.hero-lede{font-size:17px}.actions .btn{font-size:14px;padding:13px 17px}.hero-art{height:380px;width:100%;justify-content:center;margin-top:10px}.hero-art:before{width:345px;height:345px;top:8px;left:calc(50% - 170px)}.hero-art:after{width:305px;height:305px;top:10px;left:calc(50% - 110px)}.hero-art img{height:380px;max-width:100%}.ribbon-inner{grid-template-columns:1fr;gap:17px;padding-top:24px;padding-bottom:24px}.ribbon-item{font-size:14px}.ribbon-icon{width:33px;height:33px;flex-basis:33px}.section{padding:73px 0}.section h2{font-size:43px}.section-head{margin-bottom:34px}.section-head p{font-size:15px}.demo-grid,.value-grid,.price-grid{grid-template-columns:1fr;gap:37px}.demo-copy>p{font-size:16px}.phone-wrap{padding:42px 15px 25px;max-width:460px;margin:auto;width:100%}.phone{max-width:350px}.benefits{grid-template-columns:1fr;gap:14px}.benefit{padding:24px}.benefit h3{margin:12px 0 7px}.aside{font-size:19px}.price-card{max-width:430px}.trial-inner{display:block}.trial .btn{margin-top:25px}.footer-inner{align-items:flex-start;flex-direction:column;gap:15px}.trial{padding:65px 0}}
    @media(max-width:380px){.actions{display:grid;grid-template-columns:1fr}.actions .btn{width:100%}.hero h1{font-size:45px}.navlinks .btn{font-size:11px}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn,.bubble{transition:none;animation:none}}
.signup-section{background:var(--cream);border-top:1px solid var(--line)}.signup-grid{display:grid;grid-template-columns:1fr 1.04fr;gap:80px;align-items:center}.signup-intro h2{font:800 clamp(40px,4.3vw,60px)/1.08 var(--display);letter-spacing:-.04em;margin:15px 0 20px}.signup-intro>p{font-size:18px;color:var(--muted);max-width:480px}.signup-promise{border-left:4px solid var(--red);padding:8px 0 8px 19px;margin-top:32px;display:grid;gap:7px}.signup-promise strong{font-size:15px}.signup-promise span{color:var(--muted);font-size:14px;line-height:1.5}.signup-card{background:var(--paper);border:1px solid #e2d3bd;box-shadow:8px 8px 0 #e7d5bf;border-radius:15px;padding:37px}.signup-card h3{font:800 30px var(--display);margin:0 0 5px}.signup-caption{margin:0 0 26px;color:var(--muted);font-size:14px}.signup-card form{display:grid;gap:17px}.signup-card .form-row{display:grid;grid-template-columns:1fr 1fr;gap:15px}.signup-card label{display:grid;gap:7px;font-size:13px;font-weight:800}.signup-card input,.signup-card select{width:100%;min-width:0;min-height:49px;padding:12px 13px;border:1.5px solid #c8c6be;background:#fffefa;color:var(--navy);border-radius:7px;font:500 15px var(--font)}.signup-card input:focus,.signup-card select:focus{outline:2px solid var(--red);outline-offset:2px}.signup-submit{width:100%;border:0}.signup-submit:disabled{opacity:.6;cursor:not-allowed}.trial-feedback{margin:0;font-size:14px;line-height:1.5}.trial-feedback.error{color:#a32723}.trial-feedback.success{color:#225c37}.signup-fine,.signup-config{font-size:12px;color:var(--muted);line-height:1.5;margin:14px 0 0}.signup-config{color:#92502c;margin:0}@media(max-width:800px){.signup-grid{grid-template-columns:1fr;gap:33px}.signup-card{padding:25px}.signup-intro>p{font-size:16px}}@media(max-width:480px){.signup-card .form-row{grid-template-columns:1fr}.signup-card{padding:22px}}

.setup-section{background:var(--paper);border-top:1px solid var(--line)}.setup-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,7vw,100px);align-items:center}.setup-grid h2,.faq-grid h2{font:800 clamp(36px,4.5vw,60px)/1.08 var(--display);letter-spacing:-.035em;margin:15px 0 22px}.setup-lede{color:var(--muted);line-height:1.7;font-size:17px;margin:0 0 28px}.setup-steps{display:grid;gap:0}.setup-step{display:grid;grid-template-columns:50px 1fr;gap:15px;padding:23px 0;border-bottom:1px solid var(--line)}.setup-step:first-child{border-top:1px solid var(--line)}.setup-number{font:800 20px var(--display);color:var(--red)}.setup-step h3{font:700 20px var(--display);margin:0 0 8px}.setup-step p{color:var(--muted);line-height:1.6;margin:0;font-size:15px}.faq-section{background:var(--cream);border-top:1px solid var(--line)}.faq-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(35px,6vw,90px);align-items:start}.faq-grid>div:first-child>p{color:var(--muted);max-width:340px;line-height:1.6}.faq-list{border-top:1px solid var(--line)}.faq-list details{border-bottom:1px solid var(--line);padding:0 6px}.faq-list summary{cursor:pointer;padding:22px 34px 22px 0;position:relative;font-weight:700;font-size:16px;line-height:1.45;list-style:none}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary::after{content:'+';position:absolute;right:3px;top:17px;color:var(--red);font:500 28px var(--font)}.faq-list details[open] summary::after{content:'−'}.faq-list details p{color:var(--muted);line-height:1.7;margin:0 28px 23px 0;font-size:15px}@media(max-width:800px){.setup-grid,.faq-grid{grid-template-columns:1fr;gap:30px}.setup-grid h2,.faq-grid h2{margin-bottom:15px}}
  </style>
</head>
<body>
  <header class="topbar">
    <nav class="shell nav" aria-label="Main navigation">
      <a href="#top" class="brand" aria-label="Missie Calls home"><span class="brand-title">Missie <b>Calls</b></span></a>
      <div class="navlinks"><a href="#how">How it works</a><a href="#live-demo">Live demo</a><a href="#pricing">Pricing</a><a class="btn primary small" href={trialHref} data-trial-link>Start free trial <span aria-hidden="true">↗</span></a></div>
    </nav>
  </header>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Meet Missie. Your new right hand.</span>
          <h1 id="hero-title">Keep working.<br /><em>Missie has your missed calls covered.</em></h1>
          <p class="hero-lede">On the tools? With a customer? Having a day off? When you can't answer, Missie texts your caller, finds out what they need and sends you the details.</p>
          <div class="actions"><a class="btn primary" href="#live-demo">See Missie in action <span aria-hidden="true">↗</span></a><a class="btn outline" href={trialHref} data-trial-link>Start 14 days free</a></div>
          <div class="mini-proof">No interruptions. No missed opportunities.</div>
        </div>
        <div class="hero-art" aria-label="Missie, the helpful face of Missie Calls"><img src="/images/missie-web.webp" alt="Vintage-inspired illustration of Missie, smiling and winking in a red polka-dot headscarf" /></div>
      </div>
    </section>
    <section class="ribbon" aria-label="Benefits"><div class="shell ribbon-inner"><div class="ribbon-item"><span class="ribbon-icon"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 5v14M16 5v14"/><path d="M4 3h16v18H4z" opacity=".45"/></svg></span>Less time answering your phone</div><div class="ribbon-item"><span class="ribbon-icon"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5a7.8 7.8 0 0 1-8 8 8.5 8.5 0 0 1-3.4-.7L4 20l1.2-4.2A8 8 0 1 1 20 11.5Z"/><path d="m8.5 11.7 2.4 2.2 4.6-4.5"/></svg></span>Every missed caller gets a reply</div><div class="ribbon-item"><span class="ribbon-icon"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="16" rx="2"/><path d="M9 4.5h6M9 10h6M9 14h3M14 14l1.5 1.5L18 13"/></svg></span>Job details sent straight to you</div></div></section>
    <section id="live-demo" class="section demo anchor-offset" aria-labelledby="demo-title"><div class="shell demo-grid"><div class="demo-copy"><span class="eyebrow">Don't take our word for it</span><h2 id="demo-title">Give Missie a ring. <em>Then don't answer.</em></h2><p>See what your customers would experience when you can't pick up. It's the quickest way to understand what Missie does.</p><div class="steps"><div class="step"><span class="step-num">1</span><div><strong>Call our demo number.</strong><p>Let it ring out, just like a missed call on the job.</p></div></div><div class="step"><span class="step-num">2</span><div><strong>Missie texts you back.</strong><p>Reply naturally, as though you're enquiring about a job.</p></div></div><div class="step"><span class="step-num">3</span><div><strong>See what the owner gets.</strong><p>A tidy enquiry summary, ready to follow up when it suits.</p></div></div></div>{demoNumber ? <a href={demoHref} class="btn primary" id="demo-call-link">Call Missie Now <span aria-hidden="true">↗</span></a> : <button class="btn primary" type="button" id="demo-call-link" disabled aria-disabled="true" title="Live phone demo coming soon">Call Missie Now <span aria-hidden="true">↗</span></button>}<div class="demo-availability" id="demo-status">{demoNumber ? 'Calls and SMS are subject to standard mobile carrier rates.' : 'Live phone demo coming soon. The example conversation is available now.'}</div></div><div class="phone-wrap"><div class="phone"><div class="phone-top"></div><div class="phone-head"><span class="avatar">M</span><div><strong>Missie · Pro Carpentry</strong><small>Text message</small></div></div><div class="messages" id="messages" aria-live="polite"><div class="bubble them">Hi, it's Missie from Pro Carpentry. Sorry we couldn't take your call. What can we help you with?</div></div><div class="phone-bottom"><span>Message</span><i aria-hidden="true">➤</i></div></div><div class="preview-controls"><button class="text-button" id="replay-chat" type="button">↺ Replay conversation</button><div class="progress-dots" id="chat-dots" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i><i></i><i></i><i></i></div><button class="text-button" id="next-chat" type="button">Next message →</button></div><p class="disclosure" style="text-align:center;margin-bottom:0">Example only. This preview is not a live AI conversation.</p></div></div></section>
    <section id="how" class="section promise anchor-offset"><div class="shell"><div class="section-head"><span class="eyebrow">You're busy. That's the point.</span><h2>Less phone tag.<br/>More time for the good stuff.</h2><p>Missie takes care of the back-and-forth, so your day doesn't get hijacked every time the phone rings.</p></div><div class="benefits"><article class="benefit"><div class="benefit-glyph"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 5v14M16 5v14"/><path d="M4 3h16v18H4z" opacity=".45"/></svg></div><h3>Keep your hands on the job.</h3><p>Stay focused on the work in front of you, instead of dropping everything to answer another call.</p></article><article class="benefit"><div class="benefit-glyph"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5a7.8 7.8 0 0 1-8 8 8.5 8.5 0 0 1-3.4-.7L4 20l1.2-4.2A8 8 0 1 1 20 11.5Z"/><path d="m8.5 11.7 2.4 2.2 4.6-4.5"/></svg></div><h3>Don't leave people hanging.</h3><p>Missed callers receive a quick, helpful text that starts a conversation while you're busy.</p></article><article class="benefit"><div class="benefit-glyph"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="16" rx="2"/><path d="M9 4.5h6M9 10h6M9 14h3M14 14l1.5 1.5L18 13"/></svg></div><h3>Know who's worth calling back.</h3><p>Missie gathers the job details and sends you the important bits, without the phone tag.</p></article></div><p class="aside">She handles the interruption. You handle the important stuff.</p></div></section>
    <section class="section value"><div class="shell value-grid"><div><span class="eyebrow">The part you'll love</span><h2>Not another app to babysit.</h2><p>Missie works through ordinary text messages. Your customer replies like they normally would. You get a useful summary and decide what happens next.</p><p>For trades, salons, mechanics, small offices and anyone who can't always stop to pick up.</p></div><div><div class="quote-card"><small>Example owner notification</small><h3>New enquiry from a missed call</h3><dl><div><dt>Job</dt><dd>Kitchen renovation</dd></div><div><dt>Location</dt><dd>Kingscliff</dd></div><div><dt>Type</dt><dd>Renovation</dd></div><div><dt>Callback</dt><dd>Afternoon preferred</dd></div><div><dt>Next step</dt><dd>Call back when you're free</dd></div></dl></div><p class="note">Illustrative summary. Your business's questions can be tailored during setup.</p></div></div></section>

<section id="setup" class="section setup-section anchor-offset" aria-labelledby="setup-heading"><div class="shell setup-grid">
<div><span class="eyebrow">Keep your number. Keep your day moving.</span><h2 id="setup-heading">Missie works around the phone you already use.</h2><p class="setup-lede">No new number for customers to remember. Missie is activated when you forward your calls to a unique number we provide. Toggle off call forwarding to go back to normal.</p><a class="btn primary" href={trialHref}>Start 14 days free <span aria-hidden="true">↗</span></a></div>
<div class="setup-steps"><div class="setup-step"><span class="setup-number">01</span><div><h3>Tell us about your business.</h3><p>We tailor what Missie says and what she needs to find out from callers.</p></div></div><div class="setup-step"><span class="setup-number">02</span><div><h3>Connect your missed calls.</h3><p>Toggle on call forwarding to your unique number for all missed calls. Calls you answer stay with you.</p></div></div><div class="setup-step"><span class="setup-number">03</span><div><h3>Test it together.</h3><p>We'll run a quick test to confirm the details and send you the call summary. Then you get 14 days to trial the service.</p></div></div></div>
</div></section>
<section id="faq" class="section faq-section anchor-offset" aria-labelledby="faq-heading"><div class="shell faq-grid"><div><span class="eyebrow">A few things worth knowing</span><h2 id="faq-heading">Good questions.<br/>Simple answers.</h2><p>Need to check your particular phone setup? We'll work through it before activating your trial.</p></div><div class="faq-list">
<details><summary>Do I keep my existing phone number?</summary><p>Yes. You keep your existing number. No changes to your advertised number.</p></details>
<details><summary>How do I turn Missie on and off?</summary><p>To activate Missie, you forward calls to a unique number we provide. That's it. You turn Missie off by toggling off the forwarding.</p></details>
<details><summary>What happens when I answer a call?</summary><p>You speak to your caller as normal. Missie is intended for calls you miss, not calls you answer.</p></details>
<details><summary>What about personal calls or messages?</summary><p>Missie is set up and configured specifically for you and your needs. She recognises enquiries and personal messages, and acts accordingly based on your instructions.</p></details>
<details><summary>How long does setup take?</summary><p>We ask what you need, set up Missie in minutes, then run a real test with you. From there, your Missie is activated the moment you forward your calls.</p></details>
<details><summary>When do my 14 free days start?</summary><p>Only after Missie is connected and we've confirmed she's working.</p></details>
<details><summary>What happens after the free trial?</summary><p>You decide whether to continue at $330 per month. No paid subscription starts without your approval.</p></details>
</div></div></section>
    <section id="pricing" class="section price anchor-offset"><div class="shell price-grid"><div><span class="eyebrow">Straight-up pricing</span><h2>Put Missie to work. See if she's worth keeping.</h2><p class="lede">Start with 14 days free. See how Missie fits your business before deciding to subscribe.</p><ul><li>SMS follow-ups for missed calls</li><li>Helpful conversations that gather job details</li><li>Clear enquiry summaries for you</li><li>Setup tailored to your business</li><li>No subscription starts without your approval</li></ul></div><div class="price-card"><span class="label">One simple plan</span><div class="amount">$330 <small>/ month</small></div><p>After your 14-day free trial. Australian dollars. GST treatment and usage terms confirmed during signup.</p><a href={trialHref} class="btn primary" data-trial-link>Start my 14-day trial <span aria-hidden="true">↗</span></a><p style="text-align:center;font-size:12px;margin-bottom:0">Try it first. Decide later.</p></div></div></section>
    <section id="trial" class="trial anchor-offset"><div class="shell trial-inner"><div><h2>You've got better things to do than answer every call.</h2><p>Put Missie to work while you get on with yours.</p></div><div><a href={trialHref} class="btn light" data-trial-link>Start 14 days free <span aria-hidden="true">↗</span></a><p id="trial-status" style="font-size:12px;max-width:250px">Fill in the short form below to request your trial.</p></div></div></section>
<section id="trial-signup" class="section signup-section anchor-offset" aria-labelledby="signup-title"><div class="shell signup-grid"><div class="signup-intro"><span class="eyebrow">14 days on us</span><h2 id="signup-title">Let's get Missie working for you.</h2><p>Tell us a little about your business. We'll help get your missed-call forwarding and Missie set up.</p><div class="signup-promise"><strong>No card required to request your trial.</strong><span>Your 14 days start when Missie is activated and working — not when you send this form.</span></div></div><div class="signup-card"><h3>Start your free trial</h3><p class="signup-caption">Just the basics. About a minute.</p><form id="trial-form"><div class="form-row"><label>Your name<input name="name" autocomplete="name" maxlength="100" required placeholder="Your name"/></label><label>Business name<input name="business" autocomplete="organization" maxlength="120" required placeholder="Business name"/></label></div><div class="form-row"><label>Mobile number<input name="mobile" autocomplete="tel" type="tel" maxlength="40" required placeholder="04xx xxx xxx"/></label><label>Email address<input name="email" autocomplete="email" type="email" maxlength="200" required placeholder="you@business.com.au"/></label></div><label>What type of work do you do?<input name="trade" type="text" maxlength="100" required autocomplete="off" placeholder="e.g. Electrician, beauty salon, mechanic…" /></label>{turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div> : <p class="signup-config">Registration will open once the security check is connected.</p>}<button class="btn primary signup-submit" type="submit" disabled={!turnstileSiteKey}>Request my 14-day trial <span aria-hidden="true">↗</span></button><p id="trial-feedback" role="status" aria-live="polite" class="trial-feedback"></p></form><p class="signup-fine">We'll only use your details to arrange your trial. No subscription begins without your approval.</p></div></div></section>
  </main>
  <footer class="footer"><div class="shell footer-inner"><div><div class="footer-brand">Missie Calls</div><span>Work uninterrupted. Missie has it covered.</span></div><p>© {new Date().getFullYear()} Missie Calls · Australia</p><p>Built for busy businesses.</p></div></footer>
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    const steps = [
      {"side":"them","text":"Hi, it's Missie from Pro Carpentry. Sorry we couldn't take your call. What can we help you with?"},
      {"side":"us","text":"Hi, we're looking at renovating our kitchen in Kingscliff."},
      {"side":"them","text":"Sounds good. Is this an existing home renovation or part of a new build?"},
      {"side":"us","text":"Existing house."},
      {"side":"them","text":"No worries. When's the best time to call back?"},
      {"side":"us","text":"Anytime this afternoon would be great."},
      {"side":"them","text":"Got it. I'll let the team know to give you a call back asap."}
    ];
    const container = document.getElementById('messages');
    const next = document.getElementById('next-chat');
    const replay = document.getElementById('replay-chat');
    const dots = document.getElementById('chat-dots');
    let index = 1;
    function render(){
      if(!container) return;
      container.replaceChildren();
      steps.slice(0,index).forEach(s=>{const el=document.createElement('div');el.className=`bubble ${s.side}`;el.textContent=s.text;container.appendChild(el)});
      container.scrollTop = container.scrollHeight;
      dots?.querySelectorAll('i').forEach((dot,n)=>dot.classList.toggle('on',n===Math.min(steps.length-1,Math.max(0,index-1))));
      if(next)next.textContent=index===steps.length?'Start again ↻':'Next message →';
    }
    next?.addEventListener('click',()=>{index=index>=steps.length?1:index+1;render()});
    replay?.addEventListener('click',()=>{index=1;render()});
    const trialForm = document.getElementById('trial-form');
    trialForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = trialForm.querySelector('button[type=submit]');
      const feedback = document.getElementById('trial-feedback');
      if (!trialForm.reportValidity()) return;
      const fd = new FormData(trialForm);
      const token = fd.get('cf-turnstile-response');
      if (!token) { feedback.textContent='Please complete the security check.'; feedback.className='trial-feedback error'; return; }
      button.disabled=true; button.textContent='Submitting…';
      try {
        const result = await fetch('/api/trial',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name:fd.get('name'),business:fd.get('business'),mobile:fd.get('mobile'),email:fd.get('email'),trade:fd.get('trade'),turnstileToken:token})});
        const body = await result.json();
        feedback.textContent=body.message || 'Please try again.';
        feedback.className='trial-feedback '+(result.ok?'success':'error');
        if(result.ok) {trialForm.reset();window.turnstile?.reset?.();button.textContent='Request received ✓';}
        else {button.disabled=false;button.textContent='Request my 14-day trial ↗';window.turnstile?.reset?.();}
      } catch {
        feedback.textContent='Unable to submit right now. Please try again.';feedback.className='trial-feedback error';button.disabled=false;button.textContent='Request my 14-day trial ↗';window.turnstile?.reset?.();
      }
    });
  </script>
</body>
</html>
